# /opt/loboo-webui/loboo-webui.env 的写法（权限 600）。带 <> 的是每台机器自己生成的值，不进仓库。
# Open WebUI 的多数开关只在第一次启动时写进数据库，之后以管理后台或数据库里的值为准。

# ── 每台机器生成 ──
DATABASE_URL=postgresql://loboo_webui:<口令>@172.17.0.1:5432/loboo-webui
# 定下后不能改：改了所有人掉线。
WEBUI_SECRET_KEY=<随机串>
# 库为空时用它建管理员；不要用 @loboo.ai，那是萝卜成员的登录名。
WEBUI_ADMIN_EMAIL=owner@m.loboo-ai.com
WEBUI_ADMIN_PASSWORD=<随机串>
WEBUI_ADMIN_NAME=管理员
# 与萝卜服务 .env 的 LOBOO_WEBUI_SERVICE_TOKEN 相同。
LOBOO_SERVICE_TOKEN=<随机串，至少 32 个字符>

# ── 目录：代码、数据都在 /opt/loboo-webui ──
DATA_DIR=/opt/loboo-webui/data
STATIC_DIR=/opt/loboo-webui/data/static
FRONTEND_BUILD_DIR=/opt/loboo-webui/app/build
HF_HOME=/opt/loboo-webui/data/cache/embedding/models
SENTENCE_TRANSFORMERS_HOME=/opt/loboo-webui/data/cache/embedding/models
WHISPER_MODEL_DIR=/opt/loboo-webui/data/cache/whisper/models
TIKTOKEN_CACHE_DIR=/opt/loboo-webui/data/cache/tiktoken

# ── 站点 ──
ENV=prod
# 左上角、标签页标题，按原样显示（本 fork 不再追加 " (Open WebUI)"）；与前端 src/lib/constants.ts 的 APP_NAME 保持一致。
WEBUI_NAME=LoboOS
WEBUI_URL=https://m.loboo-ai.com
# 每个对外域名都要列上（分号分隔）：socket.io 按它校验来源，漏了的域名聊天没有输出。
# m.haina-api.net 给小程序用（小程序只能打开它后台配置的业务域名）。
CORS_ALLOW_ORIGIN=https://m.loboo-ai.com;https://m.haina-api.net
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SECURE=true
DEFAULT_LOCALE=zh-CN
ENABLE_SIGNUP=false
ENABLE_OLLAMA_API=false
ENABLE_DIRECT_CONNECTIONS=false
# 萝卜代办开号用管理员 API key，只放开这两组接口。
ENABLE_API_KEYS=true
ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS=true
API_KEYS_ALLOWED_ENDPOINTS=/api/v1/users,/api/v1/auths/add
# 模型从 CPA 动态拉取，所有成员都能看到全部模型。
BYPASS_MODEL_ACCESS_CONTROL=true
ENABLE_VERSION_UPDATE_CHECK=false
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ── 萝卜接入（backend/open_webui/loboo）──
LOBOO_SERVICE_URL=http://172.17.0.1:18101
LOBOO_CPA_BASE_URL=https://ootd.haina-api.net/v1
LOBOO_TRUSTED_ORIGINS=https://service.loboo-ai.com,https://loboo-service.haina-api.net
# 萝卜服务首页：浏览器里进入失败时，出错页的「回萝卜重新进入」链到这里（成员没有可用的密码）。
LOBOO_PORTAL_URL=https://service.loboo-ai.com/account/
# 萝卜的公网源站：成员头像在它的 /_media/ 下（LOBOO_SERVICE_URL 那个内网端口没有）。不写时不同步头像，昵称照常同步。
LOBOO_MEDIA_ORIGIN=https://service.loboo-ai.com
# 联网搜索由 CPA 上的这个模型用原生 web_search 执行（不写时为 gpt-6.1-sol），要选 CPA 上有渠道支持原生搜索的 GPT 模型。
# LOBOO_SEARCH_MODEL=gpt-6.1-sol
